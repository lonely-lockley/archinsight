environment eu
    name = Europe

deployment production
    csp:
        name = Digitalocean

    cdn:
        archinsightServiceProvider cf
            name = Cloudflare

    compute:
        name = Kubernetes

    storage:
        name = Postgres

    publicGateway:
        archinsightPublicGateway publicGateway
            name = Envoy EU
            cdn:
                cf
            loadBalancer:
                infrastructureComponent lb
                    name = Load Balancer
            projection:
                source $from originalLink target cdn
                target cdn connectTo target loadBalancer
                target loadBalancer connectTo target $this
                target $this connectTo target $to

    privateGateway:
        archinsightPrivateGateway privateGateway
            name = Private Network
            projection:
                source $from originalLink target $to

    egress:
        egress egress
            name = Egress
            projection:
                source $from originalLink target $to

    observability:
        metrics observability
            name = Grafana Agent
            display:
                infrastructureComponent grafana
                    name = Grafana Cloud
            projection:
                target $this connectTo source $from
                target $this connectTo target display
