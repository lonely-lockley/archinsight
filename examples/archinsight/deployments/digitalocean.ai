# This source instantiates the production deployment and its concrete
# infrastructure for the `eu` environment.
# For detailed documentation about deployment boundaries please refer to:
# https://archinsight.org/doc/deployment/#environment-and-deployment-boundaries

environment eu
    name = Europe

deployment production
    csp:
        archinsightServiceProvider csp
            name = Digitalocean
            technology = Digitalocean

    cdn:
        archinsightServiceProvider cf
            name = Cloudflare
            technology = Cloudflare

    compute:
        compute compute
            name = Kubernetes
            technology = Kubernetes
            runsOn:
                csp

    storage:
        storage storage
            name = Postgres
            technology = Postgres
            runsOn:
                csp
            route:
                $from originalLink $this

    publicGateway:
        archinsightPublicGateway publicGateway
            name = Public ingress path
            cdn:
                cf
            loadBalancer:
                infrastructureComponent lb
                    name = DigitalOcean Load Balancers
                    technology = Digitalocean
                    runsOn:
                        csp
            ingress:
                ingress traefik
                    name = Traefik
                    technology = Traefik Proxy
                    description = Kubernetes ingress controller for public frontend and API traffic
                    runsOn:
                        compute

    privateGateway:
        archinsightPrivateGateway privateGateway
            name = Private Network
            runsOn:
                compute

    egress:
        egress egress
            name = Egress
            runsOn:
                compute

    observability:
        metrics observability
            name = Grafana Agent
            technology = Grafana
            description = Collects metrics from all sources
            runsOn:
                compute
            display:
                infrastructureComponent grafana
                    name = Grafana Cloud
                    technology = Grafana
            route:
                $this connectTo display
                    technology = HTTPS, REST

route publicInbound
    inbound:
        $from originalLink cdn
        cdn connectTo loadBalancer
            technology = HTTPS, REST
        loadBalancer connectTo ingress
            technology = HTTPS, REST
        ingress connectTo $to
            technology = HTTP, REST

route privateInternal
    outbound:
        $from originalLink $to

route externalOutbound
    outbound:
        $from originalLink $to
