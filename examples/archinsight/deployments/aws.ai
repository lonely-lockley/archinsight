# Production deployment and concrete AWS infrastructure for the `sa`
# environment. It mirrors the topology of the `eu` environment.

environment sa
    name = South America

deployment production
    csp:
        archinsightServiceProvider csp
            name = AWS
            technology = AWS

    cdn:
        archinsightServiceProvider cf
            name = CloudFront
            technology = AWS CloudFront

    compute:
        compute compute
            name = Elastic Kubernetes Service
            technology = Kubernetes, AWS EKS
            runsOn:
                csp

    storage:
        storage storage
            name = Aurora PostgreSQL
            technology = PostgreSQL, Amazon Aurora
            runsOn:
                csp
            projection:
                source $from originalLink target $this

    publicGateway:
        archinsightPublicGateway publicGateway
            name = Public ingress path

            cdn:
                cf

            loadBalancer:
                infrastructureComponent lb
                    name = Application Load Balancer
                    technology = AWS ALB
                    runsOn:
                        csp

            ingress:
                ingress traefik
                    name = Traefik
                    technology = Traefik Proxy
                    description = Kubernetes ingress controller for public frontend and API traffic
                    runsOn:
                        compute

            projection:
                source $from originalLink target cdn

                target cdn connectTo target loadBalancer
                    technology = HTTPS, REST

                target loadBalancer connectTo target ingress
                    technology = HTTPS, REST

                target ingress connectTo target $to
                    technology = HTTP, REST

    privateGateway:
        archinsightPrivateGateway privateGateway
            name = Private Network
            technology = Kubernetes networking
            runsOn:
                compute
            projection:
                source $from originalLink target $to

    egress:
        egress egress
            name = Egress
            technology = AWS networking
            runsOn:
                compute
            projection:
                source $from originalLink target $to

    observability:
        metrics observability
            name = Grafana Agent
            technology = Grafana
            description = Collects metrics from all deployed services
            runsOn:
                compute

            display:
                infrastructureComponent grafana
                    name = Grafana Cloud
                    technology = Grafana

            projection:
                target $this connectTo target display
                    technology = HTTPS, REST