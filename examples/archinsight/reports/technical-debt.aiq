# This analytical report finds dependencies, or their source elements,
# explicitly marked as deprecated so they can be reviewed as technical debt.
# In the playground, select the `annotations` context.
# For detailed documentation please refer to:
# https://archinsight.org/doc/annotations/#inspecting-annotations

MATCH (source:Element)-[dependency:REFERENCES]->(target:Element)
WHERE source.context = $context
WITH source, dependency, target,
     any(annotation IN annotations(source) WHERE annotation.name = 'deprecated') AS sourceDeprecated,
     any(annotation IN annotations(dependency) WHERE annotation.name = 'deprecated') AS dependencyDeprecated
WHERE sourceDeprecated OR dependencyDeprecated
RETURN TABLE elementId(source) AS source,
             source.name AS sourceName,
             source.type AS sourceType,
             sourceDeprecated,
             elementId(target) AS target,
             target.name AS targetName,
             dependency.type AS dependencyType,
             dependencyDeprecated,
             dependency.technology AS technology,
             dependency.description AS description
ORDER BY source, target
