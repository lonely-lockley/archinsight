define type DeploymentElement of BoundaryElement
    capability = "deployment-element"

extend type Element
    List of Edge deployment
        capability = "deployment-actions"

define type InfrastructureComponent of DeploymentElement
    constructor infrastructureComponent

    capability = "infrastructure"

    Text name
    Text technology
    Text description
    InfrastructureComponent runsOn
        capability = "placement-owner"
    List of PhysicalWire projection
    List of InfrastructureComponent _

define type ProjectionTerm

define type DeploymentProfile of BoundaryElement
    constructor deploymentProfile

    capability = "deployment-profile"

    required List of Deployment appliesTo
        capability = "deployment-profile-members"
        capability = "reference-only"
    List of Edge _

define type Storage of InfrastructureComponent
    constructor storage

define presentation Storage
    graphviz
        shape = cylinder

define type Broker of NetworkConnection
    constructor broker

    Text address

define presentation Broker
    graphviz
        visible = true
        shape = box
        style = filled,dashed

define type Compute of InfrastructureComponent
    constructor compute

    Text address
    List of InfrastructureComponent components

define type NetworkConnection of InfrastructureComponent
    constructor networkConnection

    capability = "network-connection"

define type Environment of BoundaryElement
    constructor environment

    capability = "document-aggregate-root"
    capability = "environment"

    required Text name
    Text region
    List of DeploymentElement _

define type Deployment of DeploymentElement
    constructor deployment

    capability = "document-aggregate-member"
    capability = "deployment"

    Text name
    List of DeploymentElement _

define presentation DeploymentProfile
    graphviz
        visible = false

define presentation NetworkConnection
    graphviz
        visible = false
