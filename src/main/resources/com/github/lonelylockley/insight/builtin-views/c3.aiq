MATCH (container:ContainerElement)-[contains:CONTAINS]->(component:ComponentElement)
WHERE container.sourceIdentity = $tab
OPTIONAL MATCH (component)-[componentLink:REFERENCES {withDerived}]-(relatedComponent:ComponentElement)
OPTIONAL MATCH (component)-[externalLink:REFERENCES {withDerived}]-(externalSystem:SystemElement)
WHERE externalSystem IS External
GROUP BY component.parent
RETURN component, componentLink, relatedComponent, externalLink, externalSystem
