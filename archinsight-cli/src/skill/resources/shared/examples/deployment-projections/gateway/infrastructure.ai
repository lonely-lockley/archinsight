environment eu
    name = Europe

deployment production
    compute:
        compute kubernetes
            name = Kubernetes

    publicGateway:
        publicGateway public_edge
            name = Public edge
            gateway:
                infrastructureComponent edge_gateway
                    name = Edge gateway
            loadBalancer:
                infrastructureComponent load_balancer
                    name = Load balancer

route publicInbound
    inbound:
        $from originalLink gateway
        gateway connectTo loadBalancer
            technology = HTTPS
        loadBalancer connectTo $to
            technology = HTTP
