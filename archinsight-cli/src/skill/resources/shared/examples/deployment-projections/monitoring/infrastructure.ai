environment eu
    name = Europe

deployment production
    compute:
        compute kubernetes
            name = Kubernetes

    observability:
        monitoring telemetry
            name = Telemetry agent
            prometheus:
                infrastructureComponent prometheus
                    name = Prometheus
            collector:
                infrastructureComponent otel_collector
                    name = OpenTelemetry Collector
            projection:
                $this connectTo $from
                $this connectTo prometheus
                $this connectTo collector
