environment eu
    name = Europe

deployment production
    cloud:
        serviceProvider aws
            name = AWS

    compute:
        compute kubernetes
            name = Kubernetes
            runsOn:
                aws

    storage:
        storage postgres
            name = PostgreSQL
            runsOn:
                aws
            route:
                $from originalLink $this

    publicGateway:
        publicGateway public_edge
            name = Public ingress
            cdn:
                infrastructureComponent cloudfront
                    name = CloudFront
                    runsOn:
                        aws
            loadBalancer:
                infrastructureComponent alb
                    name = Application Load Balancer
                    runsOn:
                        aws

    network:
        networkConnection service_network
            name = Service network
            runsOn:
                kubernetes

    egress:
        egress outbound
            name = Outbound network
            runsOn:
                kubernetes

    observability:
        monitoring telemetry
            name = OpenTelemetry Collector
            runsOn:
                kubernetes
            display:
                infrastructureComponent grafana
                    name = Grafana Cloud
            route:
                $this connectTo $from
                $this connectTo display

route publicInbound
    inbound:
        $from originalLink cdn
        cdn connectTo loadBalancer
            technology = HTTPS
        loadBalancer connectTo $to
            technology = HTTPS

route clusterLocal
    outbound:
        $from originalLink $to

route externalOutbound
    outbound:
        $from originalLink $to
