{
  "name": "@archinsight/cli",
  "version": "3.0.2",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonely-lockley/archinsight.git",
    "directory": "archinsight-cli"
  },
  "homepage": "https://github.com/lonely-lockley/archinsight/tree/master/archinsight-cli#readme",
  "bugs": {
    "url": "https://github.com/lonely-lockley/archinsight/issues"
  },
  "bin": {
    "archinsight": "build/index.js"
  },
  "files": [
    "build/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "prebuild": "node ../packages/insight-language/scripts/ensure-generated.mjs && npm run generate:version",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --external:@viz-js/viz",
    "test:skill": "node scripts/skill-contracts.mjs && node scripts/relationship-direction-skill-contracts.mjs && node scripts/text-type-skill-contracts.mjs && node scripts/view-externality-skill-contracts.mjs && node scripts/analysis-skill-contracts.mjs",
    "check": "npm run build && npm run test:skill",
    "pack:dry": "npm pack --dry-run",
    "publish:npm": "npm publish --access public --tag next"
  },
  "dependencies": {
    "@viz-js/viz": "^3.28.0",
    "archy": "^1.0.0"
  },
  "devDependencies": {
    "@insight/language": "file:../packages/insight-language",
    "@types/archy": "^0.0.36",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
