{
  "name": "@archinsight/web",
  "version": "3.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../packages/insight-language run sync:core",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm --prefix ../packages/insight-language run sync:core",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync:svelte-kit": "svelte-kit sync",
    "precheck": "npm --prefix ../packages/insight-language run sync:core",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:security": "vitest run src/lib/svg-sanitizer.test.ts --environment happy-dom",
    "test:server": "vitest run src/routes/api/**/*.test.ts src/lib/server/**/*.test.ts",
    "test:postgres": "ARCHINSIGHT_POSTGRES_INTEGRATION=true vitest run src/lib/server/repository/postgres-repository-file-system.integration.test.ts"
  },
  "dependencies": {
    "@insight/language": "file:../packages/insight-language",
    "@sveltejs/kit": "^2.70.2",
    "@viz-js/viz": "^3.28.0",
    "@vscode/codicons": "0.0.46-24",
    "monaco-editor": "0.56.0",
    "pg": "^8.22.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "happy-dom": "^20.10.6",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "dompurify": "^3.4.12"
  }
}
