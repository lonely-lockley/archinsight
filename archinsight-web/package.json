{
  "name": "@archinsight/web",
  "version": "3.0.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node ../packages/insight-language/scripts/ensure-generated.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node ../packages/insight-language/scripts/ensure-generated.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync:svelte-kit": "svelte-kit sync",
    "pretest": "node ../packages/insight-language/scripts/ensure-generated.mjs && svelte-kit sync",
    "pretest:coverage": "node ../packages/insight-language/scripts/ensure-generated.mjs && svelte-kit sync",
    "precheck": "node ../packages/insight-language/scripts/ensure-generated.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node ../scripts/check-coverage.mjs web coverage/coverage-summary.json",
    "verify": "npm run test:coverage && npm run coverage:check",
    "check": "npm run typecheck && npm run verify",
    "test:unit": "vitest run src/lib/diagram-query-presets.test.ts",
    "test:security": "vitest run src/lib/svg-sanitizer.test.ts src/lib/graphviz-renderer.test.ts --environment happy-dom",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "pretest:server": "node ../packages/insight-language/scripts/ensure-generated.mjs",
    "test:server": "vitest run src/routes/api/**/*.test.ts src/lib/server/**/*.test.ts src/lib/actions/*.test.ts"
  },
  "dependencies": {
    "@archinsight/contracts": "file:../packages/archinsight-contracts",
    "@archinsight/editor-support": "file:../packages/archinsight-editor-support",
    "@archinsight/graphviz": "file:../packages/archinsight-graphviz",
    "@archinsight/workbench": "file:../packages/archinsight-workbench",
    "@insight/language": "file:../packages/insight-language",
    "@sveltejs/kit": "^2.70.2",
    "@viz-js/viz": "^3.28.0",
    "@vscode/codicons": "0.0.46-24",
    "monaco-editor": "0.56.0",
    "pg": "^8.22.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.6",
    "happy-dom": "^20.10.6",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18"
  }
}
