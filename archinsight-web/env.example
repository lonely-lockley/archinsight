ARCHINSIGHT_REPOSITORY_BACKEND=postgres
ARCHINSIGHT_DATABASE_ENABLED=true
ARCHINSIGHT_DATABASE_URL=postgres://archinsight:archinsight@localhost:5432/archinsight
ARCHINSIGHT_DATABASE_MIGRATIONS_ENABLED=true
ARCHINSIGHT_DATABASE_MAX_CONNECTIONS=10
ARCHINSIGHT_RUNTIME_PROFILE=all

ARCHINSIGHT_RENDERER_ENABLED=false
# Required only when the optional external fallback is enabled.
ARCHINSIGHT_RENDERER_URL=http://127.0.0.1:3000
ARCHINSIGHT_RENDERER_TOKEN=replace-with-a-random-service-token
ARCHINSIGHT_RENDERER_TIMEOUT_MS=7000
ARCHINSIGHT_RENDERER_MAX_RESPONSE_BYTES=16777216
ARCHINSIGHT_RENDERER_MAX_SVG_BYTES=2097152
ARCHINSIGHT_RENDERER_MAX_TOTAL_SVG_BYTES=8388608

ARCHINSIGHT_LIMITS_MAX_FILE_BYTES=1048576
ARCHINSIGHT_LIMITS_MAX_OVERLAYS=100
ARCHINSIGHT_LIMITS_MAX_OVERLAY_BYTES=1048576
ARCHINSIGHT_LIMITS_MAX_QUERY_CHARS=20000
ARCHINSIGHT_LIMITS_MAX_RENDER_COUNT=16
ARCHINSIGHT_LIMITS_MAX_DOT_BYTES=1048576

# Stores only saved repository models. Browser overlays are analyzed transiently.
ARCHINSIGHT_ANALYSIS_CACHE_MAX_ENTRIES=32
ARCHINSIGHT_ANALYSIS_CACHE_TTL_SECONDS=900
ARCHINSIGHT_ANALYSIS_CACHE_MAX_ENTRY_SOURCE_BYTES=16777216
ARCHINSIGHT_ANALYSIS_CACHE_MAX_TOTAL_SOURCE_BYTES=67108864

ARCHINSIGHT_AUTH_DEV_LOGIN_ENABLED=false
ARCHINSIGHT_AUTH_DEV_USER_ID=5913933c-2268-41e1-a558-622dc11f675a
ARCHINSIGHT_AUTH_DEV_USER_EMAIL=dev@archinsight.local
ARCHINSIGHT_AUTH_DEV_USER_DISPLAY_NAME=Development User
ARCHINSIGHT_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ARCHINSIGHT_AUTH_TOKEN_TTL_MINUTES=1440
ARCHINSIGHT_AUTH_STANDALONE_SYNC_API_TOKEN=replace-me

ARCHINSIGHT_AUTH_OIDC_PROVIDERS=google
ARCHINSIGHT_AUTH_OIDC_CALLBACK_BASE_URL=http://localhost:5173
ARCHINSIGHT_AUTH_OIDC_GOOGLE_CLIENT_ID=replace-me
ARCHINSIGHT_AUTH_OIDC_GOOGLE_CLIENT_SECRET=replace-me
ARCHINSIGHT_AUTH_OIDC_GOOGLE_REDIRECT_URI=https://archinsight.example/oauth/callback/google

ARCHINSIGHT_AUTH_GHOST_ENABLED=false
ARCHINSIGHT_AUTH_GHOST_ADMIN_API_URL=https://ghost.example
ARCHINSIGHT_AUTH_GHOST_PUBLIC_URL=https://ghost.example
ARCHINSIGHT_AUTH_GHOST_ADMIN_API_KEY=replace-id:replace-hex-secret
ARCHINSIGHT_AUTH_GHOST_SYNC_API_TOKEN=replace-me
ARCHINSIGHT_AUTH_GHOST_SSR_COOKIE_NAME=ghost-members-ssr
ARCHINSIGHT_AUTH_GHOST_SSR_SECRET_KEY=replace-with-ghost-theme-session-secret
